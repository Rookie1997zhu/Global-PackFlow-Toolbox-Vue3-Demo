# Copy to .env before `docker compose -f deploy/compose.yml up`.
# Never commit real secrets.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,caddy
DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

POSTGRES_DB=packflow
POSTGRES_USER=packflow
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# Private upload storage (Compose mounts media_data → /data/media)
MEDIA_ROOT=/data/media
PACKFLOW_MAX_UPLOAD_BYTES=5242880
PACKFLOW_MAX_IMPORT_ROWS=2000

REDIS_URL=redis://redis:6379/0
ENGINE_TS_URL=http://engine_ts:3100
CELERY_TASK_ALWAYS_EAGER=false

# Frontend prerender origin (Compose build-arg / Pages vars)
SITE_ORIGIN=http://localhost:8080
VITE_BASE=/
